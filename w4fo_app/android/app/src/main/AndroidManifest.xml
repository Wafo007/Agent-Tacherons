<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- Micro : nécessaire à la fois pour la capture de commande existante
         (package `record`) et pour l'écoute passive locale du Wake Word
         "Wafo" (package `speech_to_text`, reconnaissance vocale on-device).
         Ces deux usages sont couverts par la même permission Android. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>
    <!-- Requis par certains OEM pour la gestion de session audio pendant la
         capture micro (évite des conflits de routage audio sur certains
         appareils Android). -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS"/>

    <!-- Écoute vocale persistante en arrière-plan (§ ANDROID SERVICE) : ces
         3 permissions sont TOUTES obligatoires pour qu'un Foreground Service
         de type "microphone" puisse démarrer sur Android récent (10+ pour le
         type de service, 13+ pour la notification). Sans elles, le service
         `WafoBackgroundService` ne démarre pas (SecurityException). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE"/>
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>

    <application
        android:label="W4FO"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />

        <!-- Foreground Service : écoute passive du mot-clé "Wafo" quand l'app
             n'est pas au premier plan (§ ANDROID SERVICE). `exported=false` :
             ce service n'est destiné qu'à W4FO lui-même, jamais appelé par une
             autre application. `foregroundServiceType="microphone"` est
             OBLIGATOIRE sur Android 14+ (sinon l'appel à `startForeground`
             lève une exception) et doit correspondre à un usage réel du micro
             — ce qui est le cas ici (voir WafoBackgroundService.kt). -->
        <service
            android:name=".WafoBackgroundService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <!-- § WHATSAPP (lecture + réponse on-device) : NotificationListenerService,
             API Android standard (utilisée par ex. par Tasker, IFTTT, Wear OS).
             Contrairement à FOREGROUND_SERVICE_MICROPHONE ci-dessus, l'accès aux
             notifications n'est PAS une "uses-permission" classique : il s'accorde
             via un écran système dédié (`ACTION_NOTIFICATION_LISTENER_SETTINGS`),
             que Flutter ouvre via `WhatsAppController.openNotificationAccessSettings()`.
             `BIND_NOTIFICATION_LISTENER_SERVICE` est la permission système que SEUL
             Android peut accorder à ce service, jamais l'app elle-même — garantie
             anti-usurpation standard de cette API. -->
        <service
            android:name=".WafoNotificationListenerService"
            android:exported="false"
            android:label="W4FO — Lecture des messages WhatsApp"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>
    <!-- § WHATSAPP : nécessaire (Android 11+, package visibility) pour que
         WafoNotificationListenerService puisse filtrer spécifiquement les
         notifications provenant des packages WhatsApp (grand public et
         WhatsApp Business), sans avoir à interroger la liste de TOUTES les
         apps installées sur l'appareil (ce qui nécessiterait la permission
         QUERY_ALL_PACKAGES, plus intrusive et volontairement évitée ici).

         Fusionné avec le bloc `<queries>` existant (requis pour
         ACTION_PROCESS_TEXT, utilisé par le moteur de texte de Flutter) —
         voir https://developer.android.com/training/package-visibility. -->
    <queries>
        <package android:name="com.whatsapp" />
        <package android:name="com.whatsapp.w4b" />
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
