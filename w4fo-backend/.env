# --- Application ---
APP_NAME=W4FO
ENVIRONMENT=development
DEBUG=true

# --- Base de données ---
# Option A — PostgreSQL local (Docker ou installation native) :
# DATABASE_URL=postgresql+asyncpg://w4fo:w4fo_dev_password@localhost:5432/w4fo_db
#
# Option B — Supabase (recommandé si tu ne veux pas installer pgvector toi-même) :
# 1. Crée un projet sur https://supabase.com
# 2. Dans l'éditeur SQL du dashboard, exécute : create extension if not exists vector;
# 3. Dashboard -> Project Settings -> Database -> Connection string -> onglet "URI"
#    -> copie la chaîne "Direct connection" (port 5432, PAS le pooler port 6543)
# 4. Remplace "postgresql://" par "postgresql+asyncpg://" en début de chaîne
DATABASE_URL=postgresql+asyncpg://postgres.iuwaeegaxrdgdpdnnxqb:MonSuperMdP123!@aws-0-eu-west-3.pooler.supabase.com:5432/postgres
# --- Sécurité / JWT ---
JWT_SECRET_KEY=change_me_in_production_use_a_long_random_string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
# Note : JWT_SECRET_KEY sert aussi à dériver la clé de chiffrement des tokens OAuth
# tiers (src/core/encryption.py). En production, préférer une clé dédiée gérée via
# un secret manager plutôt qu'une variable d'environnement partagée avec le JWT.

# --- Mistral AI ---
MISTRAL_API_KEY=9dQOmdg7LWXZJ5EhPZZBkOO2JaRM3gup
MISTRAL_MODEL=mistral-large-latest

# --- Google Calendar (V2) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# --- CORS ---
CORS_ORIGINS=["http://localhost:3000"]
